{
  "name": "@show-me-once/extension",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:fixture": "node tests/fixture.cjs",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:confirmation": "node tests/confirmation-smoke.mjs",
    "test:popup": "node tests/popup-smoke.mjs",
    "test:agent": "node tests/agent-smoke.mjs",
    "test:agent:sites": "node tests/real-sites-agent.mjs",
    "test": "node --experimental-strip-types --test lib/*.test.ts",
    "dev": "wxt --browser chrome",
    "build": "wxt build --browser chrome",
    "zip": "wxt zip --browser chrome",
    "typecheck": "wxt prepare && tsc --noEmit"
  },
  "dependencies": {
    "@show-me-once/shared": "workspace:*",
    "fflate": "0.8.2"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "wxt": "0.21.4"
  }
}
